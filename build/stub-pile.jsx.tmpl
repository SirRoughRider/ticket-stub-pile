/* ---------- app ---------- */
export default function StubPile() {
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const [storeError, setStoreError] = useState("");
  const [saving, setSaving] = useState(false);
  const [pending, setPending] = useState(null);

  const [query, setQuery] = useState("");
  const [status, setStatus] = useState("all");
  const [year, setYear] = useState("all");
  const [tag, setTag] = useState("all");
  const [person, setPerson] = useState("all");
  const [openStat, setOpenStat] = useState("");
  /* A chip click sets a precise field filter, not a text search - a venue's
     canonical name often does not appear in the entries themselves. */
  const [pick, setPick] = useState(null);
  const [sort, setSort] = useState("newest");

  const [draft, setDraft] = useState(null);
  const [formError, setFormError] = useState("");
  const [exportOpen, setExportOpen] = useState(false);
  const [researchOpen, setResearchOpen] = useState(true);

  /* load */
  useEffect(() => {
    let alive = true;
    (async () => {
      let data = null;
      try {
        const res = await window.storage.get(STORE_KEY);
        data = res && res.value ? JSON.parse(res.value) : null;
      } catch (e) {
        /* no saved list yet — that's fine */
      }
      if (!alive) return;

      if (data && Array.isArray(data.items) && data.items.length) {
        const merged = sync(data.items, data.synced);
        setItems(merged.items);
        try {
          await window.storage.set(
            STORE_KEY,
            JSON.stringify({ items: merged.items, synced: ALL_KEYS })
          );
        } catch (e) {
          /* keep going with what's on screen */
        }
      } else {
        setItems(SEED);
        try {
          await window.storage.set(
            STORE_KEY,
            JSON.stringify({ items: SEED, synced: ALL_KEYS })
          );
        } catch (e) {
          if (alive) setStoreError("The master list loaded but didn't save. Export a copy before closing this.");
        }
      }
      if (alive) setLoading(false);
    })();
    return () => {
      alive = false;
    };
  }, []);

  async function writeStore(nextItems) {
    let lastErr;
    for (let attempt = 0; attempt < 3; attempt++) {
      try {
        await window.storage.set(
          STORE_KEY,
          JSON.stringify({ items: nextItems, synced: ALL_KEYS })
        );
        return true;
      } catch (e) {
        lastErr = e;
        await new Promise((r) => setTimeout(r, 400 * Math.pow(2, attempt)));
      }
    }
    console.error("storage write failed", lastErr);
    return false;
  }

  async function persist(nextItems) {
    setItems(nextItems);
    setSaving(true);
    const ok = await writeStore(nextItems);
    setSaving(false);
    if (ok) {
      setStoreError("");
      setPending(null);
    } else {
      setPending(nextItems);
      setStoreError(
        "That change didn't save after three tries. Your edit is still on screen but not stored yet."
      );
    }
  }

  async function retrySave() {
    if (!pending) return;
    setSaving(true);
    const ok = await writeStore(pending);
    setSaving(false);
    if (ok) {
      setStoreError("");
      setPending(null);
    }
  }

  /* derived */
  /* Shows that count toward artists / venues / cities / the year bar.
     A "missed" show stays in the list but is not something you were at. */
  const counted = useMemo(() => items.filter((i) => i.status !== "missed"), [items]);

  const years = useMemo(() => {
    const s = new Set();
    items.forEach((i) => {
      const d = parseDate(i.date);
      if (d) s.add(d.y);
    });
    return [...s].sort((a, b) => b - a);
  }, [items]);

  const tally = (key) => {
    const m = {};
    counted.forEach((i) => {
      const v = (i[key] || "").trim();
      if (v) m[v] = (m[v] || 0) + 1;
    });
    return Object.entries(m).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
  };
  const cityList = useMemo(() => tally("city"), [counted]);
  const venueList = useMemo(() => {
    const m = {};
    counted.forEach((i) => {
      const k = venueKey(i.venue);
      if (k) m[k] = (m[k] || 0) + 1;
    });
    return Object.entries(m).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
  }, [counted]);
  const bandList = useMemo(() => tally("band"), [counted]);

  const yearCounts = useMemo(() => {
    const ys = counted.map((i) => String(i.date || "").slice(0, 4)).filter(Boolean);
    if (!ys.length) return {};
    const lo = Math.min(...ys.map(Number));
    const hi = Math.max(...ys.map(Number));
    const m = {};
    for (let y = lo; y <= hi; y++) m[String(y)] = 0;
    ys.forEach((y) => { m[y] += 1; });
    return m;
  }, [counted]);

  const span = useMemo(() => {
    const ys = items.map((i) => String(i.date || "").slice(0, 4)).filter(Boolean).sort();
    if (!ys.length) return "";
    return ys[0] === ys[ys.length - 1] ? ys[0] : ys[0] + "–" + ys[ys.length - 1];
  }, [items]);

  const soloCount = useMemo(
    () =>
      items.filter((i) => (i.status || "attended") === "attended" && !splitList(i.companions).length)
        .length,
    [items]
  );

  const people = useMemo(() => {
    const m = {};
    items.forEach((i) =>
      splitList(i.companions).forEach((p) => {
        m[p] = (m[p] || 0) + 1;
      })
    );
    return Object.entries(m).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
  }, [items]);

  const tags = useMemo(() => {
    const s = new Set();
    items.forEach((i) => tagList(i.tags).forEach((t) => s.add(t)));
    return [...s].sort();
  }, [items]);

  const visible = useMemo(() => {
    const q = query.trim().toLowerCase();
    let out = items.filter((i) => {
      if (status !== "all" && i.status !== status) return false;
      if (year !== "all") {
        const d = parseDate(i.date);
        if (!d || String(d.y) !== year) return false;
      }
      if (tag !== "all" && !tagList(i.tags).includes(tag)) return false;
      if (person === "__solo") {
        if (splitList(i.companions).length || i.status !== "attended") return false;
      } else if (person !== "all" && !splitList(i.companions).includes(person)) return false;
      if (pick) {
        if (pick.type === "venue" && venueKey(i.venue) !== pick.value) return false;
        if (pick.type === "band" && i.band !== pick.value) return false;
        if (pick.type === "city" && (i.city || "").trim() !== pick.value) return false;
      }
      if (!q) return true;
      const hay = [
        i.band, i.support, i.tour, i.venue, i.city,
        i.companions, i.tags, i.notes, i.seat, i.date,
      ]
        .join(" ")
        .toLowerCase();
      return hay.includes(q);
    });

    out = [...out].sort((a, b) => {
      if (sort === "artist") return String(a.band).localeCompare(String(b.band));
      if (sort === "rated") return (b.rating || 0) - (a.rating || 0);
      const da = a.date || "";
      const db = b.date || "";
      if (sort === "oldest") return da.localeCompare(db);
      return db.localeCompare(da);
    });
    return out;
  }, [items, query, status, year, tag, person, pick, sort]);

  const stats = useMemo(() => {
    const went = items.filter((i) => i.status === "attended");
    const upcoming = items.filter((i) => i.status === "tickets" || i.status === "wishlist");
    const missed = items.filter((i) => i.status === "missed");
    const uniq = (arr) => new Set(arr.filter(Boolean).map((s) => s.trim().toLowerCase())).size;
    return {
      went: went.length,
      upcoming: upcoming.length,
      missed: missed.length,
      artists: uniq(counted.map((i) => i.band)),
      venues: uniq(counted.map((i) => venueKey(i.venue))),
      cities: uniq(counted.map((i) => i.city)),
    };
  }, [items, counted]);

  const openQuestions = useMemo(
    () =>
      items
        .filter((i) => i.question && i.question.trim())
        .sort((a, b) => String(a.date).localeCompare(String(b.date))),
    [items]
  );

  /* actions */
  function openNew() {
    setFormError("");
    setDraft({ ...BLANK });
  }
  function openEdit(item) {
    setFormError("");
    setDraft({ ...BLANK, ...item });
  }
  function save() {
    if (!draft.band.trim()) {
      setFormError("Add the artist's name to save this show.");
      return;
    }
    const clean = { ...draft, band: draft.band.trim(), rating: Number(draft.rating) || 0 };
    const next = clean.id
      ? items.map((i) => (i.id === clean.id ? clean : i))
      : [...items, { ...clean, id: uid() }];
    persist(next);
    setDraft(null);
  }
  function remove(id) {
    persist(items.filter((i) => i.id !== id));
  }

  const controlStyle = {
    fontFamily: F.mono,
    fontSize: 11,
    letterSpacing: "0.08em",
    color: C.ink,
    borderColor: C.paperDeep,
    background: C.card,
  };
  const controlClass = "sp-focus border-2 px-2 py-2 outline-none";

  return (
    <div className="min-h-screen w-full px-4 py-8 sm:px-8" style={{ background: C.paper, fontFamily: F.body }}>
      <style>{`
        .sp-focus:focus-visible { outline: 2px solid ${C.pink}; outline-offset: 2px; }
        ::selection { background: ${C.pink}; color: ${C.card}; }
        @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
      `}</style>

      <div className="mx-auto w-full max-w-3xl">
        {/* masthead */}
        <header>
          <div className="flex items-start justify-between gap-4">
            <div className="min-w-0">
              <h1
                className="uppercase"
                style={{
                  fontFamily: F.display,
                  fontSize: 64,
                  lineHeight: 0.86,
                  color: C.blue,
                  letterSpacing: "0.01em",
                }}
              >
                Stub
                <br />
                Pile
              </h1>
              <p
                className="mt-3"
                style={{ fontFamily: F.body, fontSize: 15, lineHeight: 1.35, color: C.ink }}
              >
                The music we love, and the nights we were there.
              </p>
              <p
                className="mt-2 uppercase"
                style={{ fontFamily: F.mono, fontSize: 10, letterSpacing: "0.18em", color: C.muted }}
              >
                {span ? span + " · " : ""}every stub kept
              </p>
            </div>
            <div className="hidden shrink-0 sm:block" style={{ width: 210 }}>
              <StubStack />
            </div>
          </div>

          <div className="mt-6 border-t-2 pt-5" style={{ borderColor: C.ink }}>
            <div className="flex flex-wrap gap-y-4">
              <Stat figure={stats.went} label="shows seen" />
              <Stat figure={stats.upcoming} label="ahead" />
              {stats.missed ? <Stat figure={stats.missed} label="got away" /> : null}
              <Stat
                figure={stats.artists}
                label="artists"
                active={openStat === "artists"}
                onClick={() => setOpenStat(openStat === "artists" ? "" : "artists")}
              />
              <Stat
                figure={stats.venues}
                label="venues"
                active={openStat === "venues"}
                onClick={() => setOpenStat(openStat === "venues" ? "" : "venues")}
              />
              <Stat
                figure={stats.cities}
                label="cities"
                active={openStat === "cities"}
                onClick={() => setOpenStat(openStat === "cities" ? "" : "cities")}
              />
              <Stat
                figure={soloCount}
                label="flown solo"
                active={person === "__solo"}
                onClick={() => setPerson(person === "__solo" ? "all" : "__solo")}
              />
            </div>

            {openStat === "cities" ? (
              <Breakdown
                entries={cityList}
                active={pick && pick.type === "city" ? pick.value : null}
                onPick={(v) => setPick(pick && pick.type === "city" && pick.value === v ? null : { type: "city", value: v })}
              />
            ) : null}
            {openStat === "venues" ? (
              <>
                <Breakdown
                  entries={venueList}
                  active={pick && pick.type === "venue" ? pick.value : null}
                  onPick={(v) => setPick(pick && pick.type === "venue" && pick.value === v ? null : { type: "venue", value: v })}
                />
                <div className="mt-4">
                  {VENUES.filter((v) =>
                    items.some((i) => venueRecord(i.venue) && venueRecord(i.venue).id === v.id)
                  ).map((v) => (
                    <p key={v.id} className="mb-1" style={{ fontFamily: F.mono, fontSize: 10, color: C.muted }}>
                      <span style={{ color: C.blue }}>{currentName(v)}</span>
                      {" — also known as "}
                      {v.names
                        .map(([n]) => n)
                        .filter((n, i, arr) => arr.indexOf(n) === i && norm(n) !== norm(currentName(v)))
                        .join(", ")}
                    </p>
                  ))}
                </div>
              </>
            ) : null}
            {openStat === "artists" ? (
              <Breakdown
                entries={bandList}
                active={pick && pick.type === "band" ? pick.value : null}
                onPick={(v) => setPick(pick && pick.type === "band" && pick.value === v ? null : { type: "band", value: v })}
              />
            ) : null}

            <YearBars counts={yearCounts} />
          </div>
        </header>

        {/* controls */}
        <div className="mt-6 flex flex-wrap items-center gap-2">
          <input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Search artist, venue, city, notes…"
            className={controlClass + " min-w-0 flex-1"}
            style={{ ...controlStyle, fontSize: 13, letterSpacing: "0" }}
            aria-label="Search shows"
          />
          <button
            type="button"
            onClick={openNew}
            className="sp-focus px-4 py-2 uppercase"
            style={{
              fontFamily: F.mono,
              fontSize: 11,
              letterSpacing: "0.16em",
              background: C.blue,
              color: C.card,
            }}
          >
            + Add show
          </button>
        </div>

        <div className="mt-2 flex flex-wrap items-center gap-2">
          <select value={status} onChange={(e) => setStatus(e.target.value)} className={controlClass} style={controlStyle} aria-label="Filter by status">
            <option value="all">All statuses</option>
            {Object.keys(STATUS).map((k) => (
              <option key={k} value={k}>
                {STATUS[k].label}
              </option>
            ))}
          </select>

          <select value={year} onChange={(e) => setYear(e.target.value)} className={controlClass} style={controlStyle} aria-label="Filter by year">
            <option value="all">All years</option>
            {years.map((y) => (
              <option key={y} value={String(y)}>
                {y}
              </option>
            ))}
          </select>

          <select value={tag} onChange={(e) => setTag(e.target.value)} className={controlClass} style={controlStyle} aria-label="Filter by tag">
            <option value="all">All tags</option>
            {tags.map((t) => (
              <option key={t} value={t}>
                {t}
              </option>
            ))}
          </select>

          <select
            value={person}
            onChange={(e) => setPerson(e.target.value)}
            className={controlClass}
            style={controlStyle}
            aria-label="Filter by who you went with"
          >
            <option value="all">Anyone</option>
            <option value="__solo">Solo shows ({soloCount})</option>
            {people.map(([p, n]) => (
              <option key={p} value={p}>
                {p} ({n})
              </option>
            ))}
          </select>

          <select value={sort} onChange={(e) => setSort(e.target.value)} className={controlClass} style={controlStyle} aria-label="Sort shows">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="artist">Artist A–Z</option>
            <option value="rated">Highest rated</option>
          </select>

          <button
            type="button"
            onClick={() => setExportOpen(true)}
            className="sp-focus border-2 px-3 py-2 uppercase"
            style={{ ...controlStyle, borderColor: C.paperDeep }}
          >
            Export
          </button>
        </div>

        {storeError ? (
          <div className="mt-4 border-2 p-3" style={{ borderColor: C.pink }}>
            <p style={{ fontFamily: F.mono, fontSize: 11, color: C.pink }}>{storeError}</p>
            <div className="mt-2 flex gap-4">
              <button
                type="button"
                onClick={retrySave}
                disabled={saving}
                className="sp-focus uppercase"
                style={{
                  fontFamily: F.mono,
                  fontSize: 10,
                  letterSpacing: "0.14em",
                  color: saving ? C.muted : C.blue,
                }}
              >
                {saving ? "Saving…" : "Try again"}
              </button>
              <button
                type="button"
                onClick={() => setExportOpen(true)}
                className="sp-focus uppercase"
                style={{ fontFamily: F.mono, fontSize: 10, letterSpacing: "0.14em", color: C.blue }}
              >
                Export a backup
              </button>
            </div>
          </div>
        ) : null}

        {/* research */}
        {openQuestions.length ? (
          <section className="mt-6 border-2 p-4" style={{ borderColor: C.pink, background: C.card }}>
            <button
              type="button"
              onClick={() => setResearchOpen(!researchOpen)}
              className="sp-focus flex w-full items-baseline justify-between"
            >
              <span className="uppercase" style={{ fontFamily: F.display, fontSize: 22, color: C.pink }}>
                Still to find out
              </span>
              <span
                className="uppercase"
                style={{ fontFamily: F.mono, fontSize: 10, letterSpacing: "0.14em", color: C.muted }}
              >
                {openQuestions.length} open · {researchOpen ? "hide" : "show"}
              </span>
            </button>

            {researchOpen ? (
              <ul className="mt-4">
                {openQuestions.map((item) => {
                  const d = parseDate(item.date);
                  return (
                    <li key={item.id} className="mb-3 border-t pt-3" style={{ borderColor: C.paperDeep }}>
                      <div className="flex flex-wrap items-baseline gap-x-2">
                        <span style={{ fontFamily: F.body, fontSize: 14, color: C.ink }}>{item.band}</span>
                        <span style={{ fontFamily: F.mono, fontSize: 11, color: C.muted }}>
                          {d ? MONTHS[d.m - 1] + " " + d.d + " " + d.y : "no date"}
                          {item.venue ? " · " + item.venue : ""}
                        </span>
                      </div>
                      <p className="mt-1" style={{ fontFamily: F.body, fontSize: 13, color: C.ink }}>
                        {item.question}
                      </p>
                      <button
                        type="button"
                        onClick={() => openEdit(item)}
                        className="sp-focus mt-1 uppercase"
                        style={{ fontFamily: F.mono, fontSize: 10, letterSpacing: "0.14em", color: C.blue }}
                      >
                        Answer it
                      </button>
                    </li>
                  );
                })}
              </ul>
            ) : null}
          </section>
        ) : null}

        {/* list */}
        <div className="mt-6">
          {loading ? (
            <p style={{ fontFamily: F.mono, fontSize: 12, color: C.muted }}>Opening the pile…</p>
          ) : items.length === 0 ? (
            <div className="border-2 border-dashed p-8 text-center" style={{ borderColor: C.paperDeep }}>
              <p style={{ fontFamily: F.display, fontSize: 28, color: C.blue }} className="uppercase">
                Nothing in the pile yet
              </p>
              <p className="mx-auto mt-2 max-w-sm" style={{ fontFamily: F.body, fontSize: 14, color: C.muted }}>
                Start with the last show you went to, or the next one you already have tickets for.
              </p>
              <button
                type="button"
                onClick={openNew}
                className="sp-focus mt-5 px-5 py-3 uppercase"
                style={{ fontFamily: F.mono, fontSize: 11, letterSpacing: "0.16em", background: C.blue, color: C.card }}
              >
                Log a show
              </button>
            </div>
          ) : visible.length === 0 ? (
            <div className="border-2 border-dashed p-8 text-center" style={{ borderColor: C.paperDeep }}>
              <p style={{ fontFamily: F.body, fontSize: 14, color: C.muted }}>
                No shows match that. Try a shorter search, or reset the filters.
              </p>
              <button
                type="button"
                onClick={() => {
                  setQuery("");
                  setStatus("all");
                  setYear("all");
                  setTag("all");
                  setPerson("all");
                  setPick(null);
                }}
                className="sp-focus mt-4 uppercase"
                style={{ fontFamily: F.mono, fontSize: 10, letterSpacing: "0.14em", color: C.blue }}
              >
                Reset filters
              </button>
            </div>
          ) : (
            <>
              <div className="mb-3 flex flex-wrap items-center gap-3">
                <span
                  className="uppercase"
                  style={{ fontFamily: F.mono, fontSize: 10, letterSpacing: "0.16em", color: C.muted }}
                >
                  Showing {visible.length} of {items.length}
                </span>
                {pick ? (
                  <button
                    type="button"
                    onClick={() => setPick(null)}
                    className="sp-focus border px-2 py-1"
                    style={{ borderColor: C.blue, background: C.card }}
                  >
                    <span style={{ fontFamily: F.body, fontSize: 12, color: C.blue }}>
                      {pick.type}: {pick.value}
                    </span>
                    <span style={{ fontFamily: F.mono, fontSize: 11, color: C.pink, marginLeft: 8 }}>×</span>
                  </button>
                ) : null}
              </div>
              {visible.map((item) => (
                <Stub
                  key={item.id}
                  item={item}
                  onEdit={() => openEdit(item)}
                  onDelete={() => remove(item.id)}
                />
              ))}
            </>
          )}
        </div>

        <p className="mt-10 uppercase" style={{ fontFamily: F.mono, fontSize: 9, letterSpacing: "0.16em", color: C.muted }}>
          Saved on this device to your account · export any time
        </p>
      </div>

      {draft ? (
        <StubForm
          draft={draft}
          setDraft={setDraft}
          onSave={save}
          onCancel={() => setDraft(null)}
          error={formError}
        />
      ) : null}

      {exportOpen ? (
        <div className="fixed inset-0 z-20 overflow-y-auto" style={{ background: "rgba(21,21,26,0.45)" }}>
          <div className="mx-auto min-h-full w-full max-w-xl p-3 sm:p-6">
            <div className="p-5" style={{ background: C.card }}>
              <div className="flex items-baseline justify-between">
                <h2 className="uppercase" style={{ fontFamily: F.display, fontSize: 28, color: C.blue }}>
                  Export
                </h2>
                <button
                  type="button"
                  onClick={() => setExportOpen(false)}
                  className="sp-focus uppercase"
                  style={{ fontFamily: F.mono, fontSize: 10, letterSpacing: "0.14em", color: C.muted }}
                >
                  Close
                </button>
              </div>
              <p className="mt-3" style={{ fontFamily: F.body, fontSize: 13, color: C.muted }}>
                Every show in the pile, not just what is filtered.
              </p>

              <div className="mt-4 flex flex-wrap gap-3">
                <button
                  type="button"
                  onClick={() => exportXLSX(items)}
                  className="sp-focus px-4 py-3 uppercase"
                  style={{
                    fontFamily: F.mono, fontSize: 11, letterSpacing: "0.14em",
                    background: C.blue, color: C.card,
                  }}
                >
                  Download .xlsx
                </button>
                <button
                  type="button"
                  onClick={() => exportDocx(items)}
                  className="sp-focus border-2 px-4 py-3 uppercase"
                  style={{
                    fontFamily: F.mono, fontSize: 11, letterSpacing: "0.14em",
                    borderColor: C.blue, color: C.blue,
                  }}
                >
                  Download .docx
                </button>
                <button
                  type="button"
                  onClick={() => exportJSON(items)}
                  className="sp-focus border-2 px-4 py-3 uppercase"
                  style={{
                    fontFamily: F.mono, fontSize: 11, letterSpacing: "0.14em",
                    borderColor: C.blue, color: C.blue,
                  }}
                >
                  Backup .json
                </button>
                <button
                  type="button"
                  onClick={() => exportShowsArray(items)}
                  className="sp-focus border-2 px-4 py-3 uppercase"
                  style={{
                    fontFamily: F.mono, fontSize: 11, letterSpacing: "0.14em",
                    borderColor: C.paperDeep, color: C.muted,
                  }}
                >
                  Source .jsx
                </button>
              </div>

              <p className="mt-3" style={{ fontFamily: F.body, fontSize: 12, color: C.muted }}>
                The .json is the full backup. The .jsx is just the SHOWS array — paste it into
                the source file to bring it level with what is here, since edits made in this
                app do not write back to the file.
              </p>

              <p className="mt-4" style={{ fontFamily: F.mono, fontSize: 10, color: C.muted }}>
                Or copy the CSV below.
              </p>
              <textarea
                readOnly
                rows={12}
                value={toCSV(items)}
                onFocus={(e) => e.target.select()}
                className="sp-focus mt-3 w-full border-2 p-3 outline-none"
                style={{ fontFamily: F.mono, fontSize: 11, color: C.ink, borderColor: C.paperDeep, background: C.paper }}
              />
            </div>
          </div>
        </div>
      ) : null}
    </div>
  );
}
