/* ---------- venue registry ----------
   A venue keeps its identity through renamings. Each entry lists the names it
   has carried and when, so a show displays the name that was on the ticket
   while still grouping with the same building in the stats.
   Adding a future rename = append one line to `names`. */
const VENUES = [
  {
    id: "fairpark-amphitheatre",
    city: "Dallas, TX",
    names: [
      ["Coca-Cola Starplex Amphitheatre", "1988-07-23", "1998-12-31"],
      ["Starplex Amphitheatre", "1999-01-01", "1999-12-31"],
      ["Smirnoff Music Centre", "2000-01-01", "2007-12-31"],
      ["Superpages.com Center", "2008-01-01", "2010-12-31"],
      ["Gexa Energy Pavilion", "2011-01-01", "2016-12-31"],
      ["Starplex Pavilion", "2017-01-01", "2018-04-19"],
      ["Dos Equis Pavilion", "2018-04-20", null],
    ],
  },
  {
    id: "grand-prairie-theatre",
    city: "Grand Prairie, TX",
    names: [
      ["NextStage Performance Theater", "2002-02-01", "2004-12-31"],
      ["Nokia Theatre at Grand Prairie", "2005-01-01", "2010-01-31"],
      ["Verizon Theatre at Grand Prairie", "2010-02-01", "2018-07-26"],
      ["The Theatre at Grand Prairie", "2018-07-27", "2021-04-26"],
      ["Texas Trust CU Theatre", "2021-04-27", null],
    ],
    also: ["Nokia Live at Grand Prairie", "Nokia Theatre", "Verizon Theatre"],
  },
  {
    id: "deep-ellum-factory",
    city: "Dallas, TX",
    names: [
      ["The Bomb Factory", "2015-03-26", "2021-07-11"],
      ["The Factory in Deep Ellum", "2021-07-12", "2025-03-02"],
      ["The Bomb Factory", "2025-03-03", null],
    ],
    also: ["Bomb Factory"],
  },
  {
    id: "frisco-stadium",
    city: "Frisco, TX",
    names: [
      ["Pizza Hut Park", "2005-08-06", "2012-06-30"],
      ["FC Dallas Stadium", "2012-07-01", "2013-06-30"],
      ["Toyota Stadium", "2013-07-01", null],
    ],
  },
  {
    id: "arlington-stadium",
    city: "Arlington, TX",
    names: [
      ["Cowboys Stadium", "2009-05-27", "2013-07-24"],
      ["AT&T Stadium", "2013-07-25", null],
    ],
  },
];

const norm = (v) => String(v || "").trim().toLowerCase();

/* Every name a venue has ever used, mapped back to its id. */
const VENUE_INDEX = (() => {
  const m = {};
  VENUES.forEach((v) => {
    v.names.forEach(([n]) => { m[norm(n)] = v.id; });
    (v.also || []).forEach((n) => { m[norm(n)] = v.id; });
  });
  return m;
})();

const venueById = (id) => VENUES.find((v) => v.id === id);

function venueRecord(name) {
  return venueById(VENUE_INDEX[norm(name)]);
}

/* What the venue was called on a given date. */
function nameOnDate(v, date) {
  if (!v || !date) return null;
  const hit = v.names.find(([, from, to]) => date >= from && (!to || date <= to));
  return hit ? hit[0] : null;
}

function currentName(v) {
  if (!v) return null;
  const open = v.names.find(([, , to]) => !to);
  return open ? open[0] : v.names[v.names.length - 1][0];
}

/* Canonical label used for grouping in the stats. */
function venueKey(name) {
  const v = venueRecord(name);
  return v ? currentName(v) : String(name || "").trim();
}

