/* Stub Pile — personal concert tracker.
   Structure: DATA (the SHOWS list) is separated from the APP (page + logic)
   by labelled banners below, so the two can be edited independently.
   The portable master data is the companion file `stub-pile-data.json`.
   This file is GENERATED by build/build.py from the JSON master — edit the
   JSON (or build/stub-pile.jsx.tmpl for app changes) and rebuild. */

import React, { useEffect, useMemo, useState } from "react";
import * as XLSX from "xlsx";

/* ---------- design tokens ---------- */
const C = {
  paper: "#E6E4DA",
  paperDeep: "#D9D6CA",
  card: "#F5F3EC",
  ink: "#15151A",
  blue: "#1E2E86",
  pink: "#EF4E7B",
  muted: "#6E6C62",
};

const F = {
  display: "'Haettenschweiler','Arial Narrow Bold',Impact,Anton,sans-serif",
  body: "'Helvetica Neue',Helvetica,Arial,sans-serif",
  mono: "ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace",
};

const STATUS = {
  wishlist: { label: "Want to go", stamp: "WISH LIST", color: C.pink },
  tickets: { label: "Tickets booked", stamp: "TICKETS", color: C.blue },
  attended: { label: "Went", stamp: "ATTENDED", color: C.blue },
  missed: { label: "Missed it", stamp: "MISSED", color: C.muted },
};

const STORE_KEY = "stubpile:v1";
const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

const BLANK = {
  band: "",
  support: "",
  tour: "",
  venue: "",
  city: "",
  date: "",
  status: "attended",
  seat: "",
  companions: "",
  tags: "",
  rating: 0,
  link: "",
  notes: "",
  question: "",
};

/* the master list, with researched venue/tour/support */
/* ============================================================================
   DATA — your shows. This is the ONLY section that holds concert data.
   Master copy lives alongside this file as `stub-pile-data.json` (__COUNT__ shows,
   exported __EXPORTED__). To update: edit the JSON, then run build/build.py.
   Everything BELOW the 'APP' banner is page/logic and rarely needs touching.
   ============================================================================ */
__SHOWS_BLOCK__
/* ============================================================================
   APP — page, layout, and logic below. Data is above; leave this alone unless
   you are changing how the tracker looks or behaves.
   ============================================================================ */


const showKey = (band, date) => String(band).toLowerCase() + "|" + date;

const SEED = SHOWS.map((s) => ({
  ...BLANK,
  id: "seed-" + s.band.toLowerCase().replace(/[^a-z]/g, "").slice(0, 10) + "-" + s.date,
  band: s.band,
  date: s.date,
  companions: s.companions,
  tags: s.tags,
  venue: s.venue,
  city: s.city,
  tour: s.tour,
  support: s.support,
  notes: s.notes,
  question: s.question || "",
  status: s.status || "attended",
}));

const ALL_KEYS = SHOWS.map((s) => showKey(s.band, s.date));

/* Bring a saved list up to date: fill blanks on shows already there, then add
   any researched show that has never been added before. Anything deleted on
   purpose stays deleted, because its key is already marked as synced. */
function sync(items, synced) {
  const filled = items.map((item) => {
    const s = SHOWS.find(
      (x) =>
        x.band.toLowerCase() === String(item.band).toLowerCase() &&
        (item.date === x.date || item.date === x.oldDate)
    );
    if (!s) return item;
    const out = { ...item };
    ["venue", "city", "tour", "support", "notes", "question"].forEach((k) => {
      if (!out[k] && s[k]) out[k] = s[k];
    });
    if (s.oldDate && out.date === s.oldDate) out.date = s.date;
    return out;
  });

  const seen = new Set(synced || []);
  const present = new Set(filled.map((i) => showKey(i.band, i.date)));
  const additions = SEED.filter((s) => {
    const k = showKey(s.band, s.date);
    return !seen.has(k) && !present.has(k);
  });

  return { items: [...filled, ...additions] };
}

/* ---------- helpers ---------- */
const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36);

function parseDate(s) {
  if (!s) return null;
  const [y, m, d] = s.split("-").map(Number);
  if (!y || !m || !d) return null;
  return { y, m, d };
}

function tagList(s) {
  return String(s || "")
    .split(",")
    .map((t) => t.trim())
    .filter(Boolean);
}

/* Splits a comma-separated field, but keeps trailing parentheticals attached
   e.g. "Shadows Fall (co-headline), Vein.fm" -> two entries, not three. */
function splitList(s) {
  return String(s || "")
    .split(/,(?![^(]*\))/)
    .map((t) => t.trim())
    .filter(Boolean);
}

function csvCell(v) {
  const s = v === null || v === undefined ? "" : String(v);
  return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
}

function toCSV(rows) {
  const cols = [
    "date", "band", "support", "tour", "venue", "city", "status",
    "seat", "companions", "tags", "rating", "link", "notes", "question",
  ];
  const head = cols.join(",");
  const body = rows
    .map((r) => cols.map((c) => csvCell(c === "tags" ? tagList(r.tags).join(" / ") : r[c])).join(","))
    .join("\n");
  return head + "\n" + body;
}

const EXPORT_COLS = [
  ["date", "Date"], ["band", "Artist"], ["venue", "Venue"], ["city", "City"],
  ["tour", "Tour"], ["support", "Support / bill"], ["companions", "Went with"],
  ["status", "Status"], ["seat", "Seat"], ["tags", "Tags"],
  ["rating", "Rating"], ["notes", "Notes"], ["question", "Open question"],
];

function download(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function exportXLSX(rows) {
  const sorted = [...rows].sort((a, b) => String(b.date).localeCompare(String(a.date)));
  const data = sorted.map((r) => {
    const o = {};
    EXPORT_COLS.forEach(([k, label]) => {
      o[label] = k === "status" ? (STATUS[r[k]] || {}).label || r[k] : r[k] || "";
    });
    o.Year = String(r.date || "").slice(0, 4);
    return o;
  });
  const ws = XLSX.utils.json_to_sheet(data);
  ws["!cols"] = [
    { wch: 12 }, { wch: 26 }, { wch: 30 }, { wch: 18 }, { wch: 28 },
    { wch: 44 }, { wch: 22 }, { wch: 14 }, { wch: 12 }, { wch: 18 },
    { wch: 8 }, { wch: 55 }, { wch: 40 }, { wch: 7 },
  ];
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, "Shows");
  const out = XLSX.write(wb, { bookType: "xlsx", type: "array" });
  download(
    new Blob([out], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }),
    "stub-pile.xlsx"
  );
}

/* Full snapshot of the live data - the real backup, and what to send me
   if you want the source file regenerated. */
function exportJSON(rows) {
  const payload = {
    exported: new Date().toISOString().slice(0, 10),
    count: rows.length,
    items: [...rows].sort((a, b) => String(b.date).localeCompare(String(a.date))),
  };
  download(
    new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" }),
    "stub-pile-data.json"
  );
}

/* The SHOWS array only, as source you can paste back into the .jsx to
   bring the file level with the app. */
function exportShowsArray(rows) {
  const keys = [
    "band", "date", "companions", "tags", "venue", "city",
    "tour", "support", "notes", "question", "status",
  ];
  const q = (v) => JSON.stringify(String(v === null || v === undefined ? "" : v));
  const objs = [...rows]
    .sort((a, b) => String(b.date).localeCompare(String(a.date)))
    .map((r) => {
      const lines = keys
        .filter((k) => r[k] !== undefined && r[k] !== "" && !(k === "status" && r[k] === "attended"))
        .map((k) => "    " + k + ": " + q(r[k]) + ",");
      return "  {\n" + lines.join("\n") + "\n  },";
    });
  const src = "const SHOWS = [\n" + objs.join("\n") + "\n];\n";
  download(new Blob([src], { type: "text/plain" }), "stub-pile-shows.jsx");
}

/* ---------- real .docx ----------
   A .docx is a ZIP of OOXML parts. We build the ZIP by hand using stored
   (uncompressed) entries, which needs only a CRC32 - no zip library. */

const CRC_TABLE = (() => {
  const t = new Uint32Array(256);
  for (let n = 0; n < 256; n++) {
    let c = n;
    for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
    t[n] = c >>> 0;
  }
  return t;
})();

function crc32(bytes) {
  let c = 0xffffffff;
  for (let i = 0; i < bytes.length; i++) c = CRC_TABLE[(c ^ bytes[i]) & 0xff] ^ (c >>> 8);
  return (c ^ 0xffffffff) >>> 0;
}

function zipStore(files) {
  const enc = new TextEncoder();
  const parts = [];
  const central = [];
  let offset = 0;

  const u16 = (n) => [n & 0xff, (n >> 8) & 0xff];
  const u32 = (n) => [n & 0xff, (n >> 8) & 0xff, (n >> 16) & 0xff, (n >>> 24) & 0xff];

  files.forEach(({ name, content }) => {
    const nameBytes = enc.encode(name);
    const data = content instanceof Uint8Array ? content : enc.encode(content);
    const crc = crc32(data);

    const local = [
      ...u32(0x04034b50), ...u16(20), ...u16(0), ...u16(0),
      ...u16(0), ...u16(0),
      ...u32(crc), ...u32(data.length), ...u32(data.length),
      ...u16(nameBytes.length), ...u16(0),
    ];
    parts.push(new Uint8Array(local), nameBytes, data);

    central.push([
      ...u32(0x02014b50), ...u16(20), ...u16(20), ...u16(0), ...u16(0),
      ...u16(0), ...u16(0),
      ...u32(crc), ...u32(data.length), ...u32(data.length),
      ...u16(nameBytes.length), ...u16(0), ...u16(0), ...u16(0), ...u16(0),
      ...u32(0), ...u32(offset),
      ...Array.from(nameBytes),
    ]);
    offset += local.length + nameBytes.length + data.length;
  });

  const cd = central.flat();
  const cdBytes = new Uint8Array(cd);
  const eocd = new Uint8Array([
    ...u32(0x06054b50), ...u16(0), ...u16(0),
    ...u16(files.length), ...u16(files.length),
    ...u32(cdBytes.length), ...u32(offset), ...u16(0),
  ]);

  const total = parts.reduce((n, p) => n + p.length, 0) + cdBytes.length + eocd.length;
  const out = new Uint8Array(total);
  let pos = 0;
  parts.forEach((p) => { out.set(p, pos); pos += p.length; });
  out.set(cdBytes, pos); pos += cdBytes.length;
  out.set(eocd, pos);
  return out;
}

function esc(v) {
  return String(v === null || v === undefined ? "" : v)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

function para(runs, opts = {}) {
  const pPr =
    "<w:pPr>" +
    (opts.style ? '<w:pStyle w:val="' + opts.style + '"/>' : "") +
    (opts.indent ? '<w:ind w:left="360"/>' : "") +
    '<w:spacing w:before="' + (opts.before || 0) + '" w:after="' + (opts.after === undefined ? 40 : opts.after) + '"/>' +
    (opts.border
      ? '<w:pBdr><w:bottom w:val="single" w:sz="12" w:color="15151A"/></w:pBdr>'
      : "") +
    "</w:pPr>";
  const body = runs
    .map((r) => {
      const rPr =
        "<w:rPr>" +
        '<w:rFonts w:ascii="' + (r.font || "Calibri") + '" w:hAnsi="' + (r.font || "Calibri") + '"/>' +
        (r.bold ? "<w:b/>" : "") +
        (r.italic ? "<w:i/>" : "") +
        '<w:sz w:val="' + (r.size || 22) + '"/>' +
        '<w:color w:val="' + (r.color || "15151A") + '"/>' +
        "</w:rPr>";
      return "<w:r>" + rPr + '<w:t xml:space="preserve">' + esc(r.text) + "</w:t></w:r>";
    })
    .join("");
  return "<w:p>" + pPr + body + "</w:p>";
}

/* The masthead illustration, so the exported document carries it too. */
const STACK_PNG_B64 =
  "__STACK_PNG_B64__";

function b64ToBytes(b64) {
  const bin = atob(b64);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}

function exportDocx(rows) {
  const sorted = [...rows].sort((a, b) => String(b.date).localeCompare(String(a.date)));
  const BLUE = "1E2E86", MUTED = "6E6C62", INK = "15151A", PINK = "EF4E7B";

  const EMU_W = 1905000, EMU_H = 1359000; /* ~2in wide, aspect preserved */
  const imgPara =
    '<w:p><w:pPr><w:jc w:val="right"/><w:spacing w:after="0"/></w:pPr><w:r><w:drawing>' +
    '<wp:inline distT="0" distB="0" distL="0" distR="0" ' +
    'xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing">' +
    '<wp:extent cx="' + EMU_W + '" cy="' + EMU_H + '"/>' +
    '<wp:docPr id="1" name="Ticket stubs"/>' +
    '<a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main">' +
    '<a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture">' +
    '<pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture">' +
    '<pic:nvPicPr><pic:cNvPr id="1" name="stubs.png"/><pic:cNvPicPr/></pic:nvPicPr>' +
    '<pic:blipFill><a:blip r:embed="rId5" ' +
    'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"/>' +
    '<a:stretch><a:fillRect/></a:stretch></pic:blipFill>' +
    '<pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="' + EMU_W + '" cy="' + EMU_H + '"/></a:xfrm>' +
    '<a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr>' +
    "</pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p>";

  let xml = imgPara;
  xml += para([{ text: "Stub Pile", bold: true, size: 52, color: BLUE, font: "Arial" }], { after: 40 });
  xml += para(
    [{ text: "The music we love, and the nights we were there.", size: 22, color: MUTED }],
    { after: 240, border: true }
  );

  let year = "";
  sorted.forEach((r) => {
    const y = String(r.date || "").slice(0, 4);
    if (y && y !== year) {
      year = y;
      xml += para([{ text: y, bold: true, size: 30, color: BLUE, font: "Arial" }], { before: 320, after: 100 });
    }
    const d = parseDate(r.date);
    const when = d ? MONTHS[d.m - 1] + " " + d.d + ", " + d.y : "";
    const stamp = r.status && r.status !== "attended" ? "   [" + (STATUS[r.status] || {}).stamp + "]" : "";
    xml += para(
      [
        { text: r.band, bold: true, size: 24, color: INK },
        { text: "   " + when, size: 20, color: MUTED },
        { text: stamp, size: 18, color: MUTED },
      ],
      { before: 180, after: 30 }
    );
    const place = [r.venue, r.city].filter(Boolean).join(" · ");
    if (place) xml += para([{ text: place, size: 20 }], { indent: true, after: 30 });
    if (r.tour) xml += para([{ text: r.tour, size: 20, color: MUTED }], { indent: true, after: 30 });
    if (r.support)
      xml += para(
        [
          { text: "Also on the bill:  ", size: 20, color: MUTED },
          { text: r.support, size: 20, color: INK },
        ],
        { indent: true, after: 30 }
      );
    if (r.companions)
      xml += para(
        [
          { text: (r.status === "missed" ? "Had tickets with:  " : "Went with:  "), size: 20, color: MUTED },
          { text: r.companions, size: 20, bold: true, color: BLUE },
        ],
        { indent: true, after: 30 }
      );
    else if ((r.status || "attended") === "attended")
      xml += para([{ text: "Flew solo", size: 20, italic: true, color: PINK }], { indent: true, after: 30 });
    if (r.rating)
      xml += para([{ text: "★".repeat(r.rating), size: 20, color: PINK }], { indent: true, after: 30 });
    if (r.notes) xml += para([{ text: r.notes, size: 20, italic: true }], { indent: true, after: 30 });
    if (r.question)
      xml += para([{ text: "? " + r.question, size: 20, color: PINK }], { indent: true, after: 30 });
  });

  const document =
    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">' +
    "<w:body>" + xml +
    '<w:sectPr><w:pgSz w:w="12240" w:h="15840"/>' +
    '<w:pgMar w:top="1080" w:right="1440" w:bottom="1080" w:left="1440"/></w:sectPr>' +
    "</w:body></w:document>";

  const contentTypes =
    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">' +
    '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>' +
    '<Default Extension="xml" ContentType="application/xml"/>' +
    '<Default Extension="png" ContentType="image/png"/>' +
    '<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>' +
    "</Types>";

  const rels =
    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
    '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>' +
    "</Relationships>";

  const docRels =
    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
    '<Relationship Id="rId5" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/stubs.png"/>' +
    "</Relationships>";

  const zip = zipStore([
    { name: "[Content_Types].xml", content: contentTypes },
    { name: "_rels/.rels", content: rels },
    { name: "word/document.xml", content: document },
    { name: "word/_rels/document.xml.rels", content: docRels },
    { name: "word/media/stubs.png", content: b64ToBytes(STACK_PNG_B64) },
  ]);

  download(
    new Blob([zip], {
      type: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    }),
    "stub-pile.docx"
  );
}

/* ---------- small pieces ---------- */
function Field({ label, hint, children }) {
  return (
    <label className="block">
      <span
        className="mb-1 block uppercase"
        style={{ fontFamily: F.mono, fontSize: 10, letterSpacing: "0.14em", color: C.muted }}
      >
        {label}
      </span>
      {children}
      {hint ? (
        <span className="mt-1 block" style={{ fontFamily: F.mono, fontSize: 10, color: C.muted }}>
          {hint}
        </span>
      ) : null}
    </label>
  );
}

function Stars({ value, onChange }) {
  return (
    <div className="flex items-center gap-1">
      {[1, 2, 3, 4, 5].map((n) => (
        <button
          key={n}
          type="button"
          onClick={() => onChange(n === value ? 0 : n)}
          className="sp-focus px-1 text-xl leading-none"
          style={{ color: n <= value ? C.pink : C.paperDeep }}
          aria-label={n + " star" + (n > 1 ? "s" : "")}
        >
          ★
        </button>
      ))}
      {value ? (
        <button
          type="button"
          onClick={() => onChange(0)}
          className="sp-focus ml-1 uppercase"
          style={{ fontFamily: F.mono, fontSize: 10, color: C.muted, letterSpacing: "0.1em" }}
        >
          clear
        </button>
      ) : null}
    </div>
  );
}

function Stat({ figure, label, onClick, active }) {
  const inner = (
    <>
      <div style={{ fontFamily: F.display, fontSize: 30, lineHeight: 1, color: active ? C.pink : C.blue }}>
        {figure}
      </div>
      <div
        className="mt-1 uppercase"
        style={{
          fontFamily: F.mono,
          fontSize: 9,
          letterSpacing: "0.16em",
          color: active ? C.pink : C.muted,
          borderBottom: onClick ? "1px dotted " + (active ? C.pink : C.muted) : "none",
        }}
      >
        {label}
      </div>
    </>
  );
  if (!onClick) return <div className="pr-6">{inner}</div>;
  return (
    <button type="button" onClick={onClick} className="sp-focus pr-6 text-left">
      {inner}
    </button>
  );
}

/* A slim bar per year - enough to see the busy stretches at a glance. */
function YearBars({ counts }) {
  const years = Object.keys(counts).sort();
  if (years.length < 2) return null;
  const max = Math.max(...Object.values(counts));
  return (
    <div className="mt-5 flex items-end" style={{ height: 46, gap: 3 }}>
      {years.map((y) => {
        const n = counts[y];
        return (
          <div key={y} className="flex flex-1 flex-col items-center justify-end" title={y + ": " + n}>
            <span style={{ fontFamily: F.mono, fontSize: 8, color: C.muted, marginBottom: 2 }}>
              {n || ""}
            </span>
            <div
              style={{
                width: "100%",
                height: Math.max(2, (n / max) * 26),
                background: n ? C.blue : C.paperDeep,
              }}
            />
            <span
              style={{
                fontFamily: F.mono,
                fontSize: 7,
                color: C.muted,
                marginTop: 3,
                letterSpacing: "-0.03em",
              }}
            >
              {y.slice(2)}
            </span>
          </div>
        );
      })}
    </div>
  );
}

/* Chip list revealed when a stat is tapped. */
function Breakdown({ entries, onPick, active }) {
  return (
    <div className="mt-4 flex flex-wrap gap-1.5">
      {entries.map(([name, n]) => {
        const on = active === name;
        return (
          <button
            key={name}
            type="button"
            onClick={() => onPick && onPick(name)}
            className="sp-focus border px-2 py-1"
            style={{
              borderColor: on ? C.blue : C.paperDeep,
              background: on ? C.blue : C.card,
            }}
          >
